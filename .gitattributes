# The provisioning scripts and their SQL are mounted into a Linux container and
# executed by busybox `sh` and `psql`. This repo is edited on Windows, where
# core.autocrlf=true would hand the container CRLF files — `provision.sh` then
# dies on a stray \r and the whole stack refuses to start, with an error that
# points nowhere near the cause. Pin them.
docker-compose/postgres/**/*.sh   text eol=lf
docker-compose/postgres/**/*.sql  text eol=lf
docker-compose/schemas/*.sql      text eol=lf

# Same reasoning for the entrypoint scripts the stack shells out to.
docker-stack.sh                   text eol=lf

# The Mosquitto broker's config and its one-shot scripts, run by busybox `sh`
# inside the broker image. A CRLF mosquitto.conf is worse than a CRLF script: the
# stray \r ends up INSIDE values (a listener address, a file path) and the broker
# fails on a name that looks correct in every editor.
docker-compose/mosquitto/*        text eol=lf
