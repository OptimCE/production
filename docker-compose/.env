# ============================================
# GLOBAL CONFIGURATION
# ============================================
DOMAIN=http://localhost
DOMAIN_HOST=localhost
SSL_EMAIL=admin@localhost

# ============================================
# INIT PROFILE - Application routing
# ============================================
APP_CORS_ALLOWED_ORIGIN=http://localhost
WEB_BASE_PATH=/
WEB_API_URL=/api

# ============================================
# INIT PROFILE - Identity provider (Keycloak)
# ============================================
AUTH_REALM=optimce-realm
AUTH_INTERNAL_URL=http://keycloak:8080/keycloak
AUTH_CLIENT_SECRET=changeme_keycloak_admin_password
WEB_AUTH_URL=/keycloak
WEB_AUTH_CLIENT_ID=optimce-frontend
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin

# ============================================
# BACKEND PROFILE - Databases
#
# ONE Postgres instance (compose service `postgres`) holds six logical
# databases; `keycloak-db` remains a separate instance.
#
# Each value below is the password of ONE LOGIN ROLE, not of an instance's
# superuser: CRM_DB_PASSWORD belongs to `crm_svc`, BILLING_DB_PASSWORD to
# `billing_svc`, and so on. A leaked role password reaches that role's database
# plus a read-only view of crm_db — not everything.
#
# NOTIFICATION_DISPATCH_DB_PASSWORD is the odd one out: that role owns no
# database at all. It exists only to hold two narrow write grants on crm_db.
#
# POSTGRES_SUPERUSER_PASSWORD is used only by `postgres-init` and the backup job.
# Keep it in a different place from the rest: consolidation trades six small
# blast radii for one large one.
#
# To rotate any of them: edit here, then `./docker-stack.sh restart` — NOT
# `start`. postgres-init re-asserts every password on every run, but a running
# application container keeps the environment it was created with.
# ============================================
POSTGRES_SUPERUSER_PASSWORD=changeme_postgres_superuser_password
CRM_DB_PASSWORD=changeme_db_password
ALLOCATION_KEY_DB_PASSWORD=changeme_allocation_key_db_password
SIMULATION_KEY_DB_PASSWORD=changeme_simulation_key_db_password
NEWS_BOARD_DB_PASSWORD=changeme_news_board_db_password
BILLING_DB_PASSWORD=changeme_billing_db_password
ADMINISTRATIVE_DOCUMENT_DB_PASSWORD=changeme_administrative_document_db_password
NOTIFICATION_DISPATCH_DB_PASSWORD=changeme_notification_dispatch_db_password

# ============================================
# BACKEND PROFILE - Keycloak Database
# Separate instance (`keycloak-db`), still its own superuser. Keycloak manages
# its own schema at startup, so it is deliberately not consolidated.
# ============================================
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db_password

# ============================================
# BACKEND PROFILE - Email delivery (notification-dispatch)
#
# notification-dispatch is the only thing in the platform that sends email.
# Choose ONE transport:
#
#   EMAIL_TRANSPORT=SMTP   -> fill the SMTP_* block, leave BREVO_API_KEY empty
#   EMAIL_TRANSPORT=BREVO  -> fill BREVO_API_KEY, the SMTP_* block is ignored
#
# There is no third option here: the image also accepts NOOP, but it refuses to
# start with it outside local/test — NOOP marks every message SENT while no mail
# leaves the building.
#
# SMTP_PORT/SMTP_STARTTLS below are the real production defaults (587 + STARTTLS).
# The development stack overrides them to 1025/false for its local Mailpit; do
# not copy those values here.
# ============================================
EMAIL_TRANSPORT=SMTP
EMAIL_FROM_ADDRESS=no-reply@optimce.be
EMAIL_FROM_NAME=OptimCE
EMAIL_REPLY_TO=
# Domain used in the Message-ID header. Should match the sending domain's DNS.
EMAIL_MESSAGE_ID_DOMAIN=optimce.be
# Fallback when outbound_message.locale is empty (fr | nl | de | en).
EMAIL_DEFAULT_LOCALE=fr
SMTP_HOST=changeme_smtp_host
SMTP_PORT=587
SMTP_USERNAME=changeme_smtp_username
SMTP_PASSWORD=changeme_smtp_password
SMTP_STARTTLS=true
SMTP_TLS=false
# Only used when EMAIL_TRANSPORT=BREVO.
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
# How often the dispatcher polls outbound_message for due work.
DISPATCH_POLL_INTERVAL_SECONDS=15

# ============================================
# BACKEND PROFILE - Observability (allocation-key-generation, simulation-key)
# Required when ENV=production. Replace these placeholders with real
# ============================================
LOGGING_TOKEN=changeme_logging_token
LOGGING_TRACES_URL=changeme_logging_traces_url
LOGGING_LOGS_URL=changeme_logging_logs_url
LOGGING_METRICS_URL=changeme_logging_metrics_url

# ============================================
# BACKEND PROFILE - Storage (MinIO)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
STORAGE_BUCKET=crm-files
MINIO_PUBLIC_ENDPOINT=http://s3.localhost
# Document-generation buckets: TEMPLATES_BUCKET holds the versioned HTML templates
# seeded by minio-init, OUTPUT_BUCKET receives the rendered invoice/statement PDFs.
TEMPLATES_BUCKET=optimce-templates
OUTPUT_BUCKET=optimce-documents

# ============================================
# BACKEND PROFILE - OpenTelemetry
# ============================================
REMOTE_LOGGING=false
OTEL_EXPORTER_OTLP_ENDPOINT=none

# ============================================
# FRONTEND PROFILE - Nginx upstream hosts
# ============================================
CRM_FRONTEND_UPSTREAM=crm-frontend:80
KRAKEND_UPSTREAM=krakend:8080
KEYCLOAK_UPSTREAM=keycloak:8080
MINIO_UPSTREAM=minio:9000

# Protocols for upstream proxies
CRM_FRONTEND_PROTOCOL=http
KRAKEND_PROTOCOL=http
KEYCLOAK_PROTOCOL=http
MINIO_PROTOCOL=http

# ============================================
# FRONTEND PROFILE - SSL/HTTPS
# ============================================
USE_HTTPS=false
SSL_CERT_PATH=/etc/nginx/certs/live/${DOMAIN_HOST}/fullchain.pem
SSL_CERT_KEY_PATH=/etc/nginx/certs/live/${DOMAIN_HOST}/privkey.pem
