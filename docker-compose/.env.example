# ============================================
# GLOBAL CONFIGURATION
# ============================================
DOMAIN=http://localhost
DOMAIN_HOST=localhost
SSL_EMAIL=admin@localhost

# ============================================
# INIT PROFILE - Application routing
# ============================================
APP_CORS_ALLOWED_ORIGIN=http://localhost
WEB_BASE_PATH=/
WEB_API_URL=/api
# The realtime (SSE) stream path. SINGLE source of truth: this one value renders
# both `location = ${WEB_REALTIME_PATH}` in nginx/conf-template.d/* AND
# crm-frontend's config.json `realtimeUrl`, so the proxy and the client cannot
# drift into a permanent, silent polling fallback.
#
# Two things it must not become:
#   * empty - envsubst then renders `location =  {`, an nginx SYNTAX ERROR that
#     takes the whole reverse proxy down. Do not delete this line.
#   * a path under ${WEB_API_URL} - the frontend's Keycloak interceptor matches
#     `^(${DOMAIN}${WEB_API_URL})(/.*)?$` and would try to attach a bearer token
#     to an EventSource request, which cannot carry headers.
WEB_REALTIME_PATH=/realtime/stream

# ============================================
# INIT PROFILE - Map basemap
#
# MapLibre style JSON for the meters and public-communities maps. The value below
# is the OpenFreeMap public instance: no API key, no registration, no request
# limit, commercial use allowed, OpenStreetMap data under ODbL.
#
# It is the frontend's ONLY third-party runtime dependency, and every user's
# browser fetches it directly - it is not proxied. Its availability is outside
# your control; point this at a self-hosted style to remove that.
#
# A self-hosted style MUST serve "Noto Sans Regular" from its `glyphs` endpoint,
# or every cluster and coincidence count badge vanishes with nothing logged.
#
# Set explicitly even though the frontend's coded default is the same URL: an
# operator auditing third-party egress should find it here, not in a TypeScript
# file inside an image.
# ============================================
WEB_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ============================================
# INIT PROFILE - Identity provider (Keycloak)
# ============================================
AUTH_REALM=optimce-realm
AUTH_INTERNAL_URL=http://keycloak:8080/keycloak
AUTH_CLIENT_SECRET=changeme_keycloak_admin_password
WEB_AUTH_URL=/keycloak
WEB_AUTH_CLIENT_ID=optimce-frontend
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin

# ============================================
# BACKEND PROFILE - Databases
#
# ONE Postgres instance (compose service `postgres`) holds six logical
# databases; `keycloak-db` remains a separate instance.
#
# Each value below is the password of ONE LOGIN ROLE, not of an instance's
# superuser: CRM_DB_PASSWORD belongs to `crm_svc`, BILLING_DB_PASSWORD to
# `billing_svc`, and so on. A leaked role password reaches that role's database
# plus a read-only view of crm_db — not everything.
#
# NOTIFICATION_DISPATCH_DB_PASSWORD is the odd one out: that role owns no
# database at all. It exists only to hold two narrow write grants on crm_db.
#
# POSTGRES_SUPERUSER_PASSWORD is used only by `postgres-init` and the backup job.
# Keep it in a different place from the rest: consolidation trades six small
# blast radii for one large one.
#
# To rotate any of them: edit here, then `./docker-stack.sh restart` — NOT
# `start`. postgres-init re-asserts every password on every run, but a running
# application container keeps the environment it was created with.
# ============================================
POSTGRES_SUPERUSER_PASSWORD=changeme_postgres_superuser_password
CRM_DB_PASSWORD=changeme_db_password
ALLOCATION_KEY_DB_PASSWORD=changeme_allocation_key_db_password
SIMULATION_KEY_DB_PASSWORD=changeme_simulation_key_db_password
NEWS_BOARD_DB_PASSWORD=changeme_news_board_db_password
BILLING_DB_PASSWORD=changeme_billing_db_password
ADMINISTRATIVE_DOCUMENT_DB_PASSWORD=changeme_administrative_document_db_password
NOTIFICATION_DISPATCH_DB_PASSWORD=changeme_notification_dispatch_db_password

# ALLOCATION_KEY / SIMULATION_KEY / NEWS_BOARD_DB_PASSWORD are each consumed
# TWICE: by their own service, and by `optimce-migrator`, which connects as the
# same owning role to apply that database's migrations. Do not prune one on the
# assumption that it belongs to a single container.

# ============================================
# BACKEND PROFILE - Realtime (SSE) and its Redis
#
# REALTIME_ENABLED is the whole feature's kill switch. With it false the ticket
# endpoint 503s, crm-backend opens no Redis connection and binds nothing, every
# annexe emit() is a silent no-op, and the SPA polls exactly as it did before this
# feature existed. That is both the rollout and the rollback.
#
# It ships FALSE here, deliberately diverging from the development stack. A
# realtime failure is INDISTINGUISHABLE from a quiet system - the pollers keep the
# UI correct - so "nobody complained" is not evidence. Prove the nginx location,
# the Redis auth and the nine producer images first, then switch it on as a
# separate, reversible step. See docs/runbooks/realtime-sse.md.
#
# REDIS_PASSWORD is not hygiene. This Redis holds the LIVE TICKET STORE, and a
# ticket carries the exact channel list its holder may subscribe to, so an
# unauthenticated Redis is an impersonation oracle for anything on that network.
# Use URL-SAFE characters only: the value is interpolated into REALTIME_REDIS_URL
# in userinfo position, so `@ : / # ?` corrupt the DSN and `$` is eaten by compose
# interpolation. Generate it with:
#   openssl rand -hex 32
#
# The ceilings below are pinned rather than inherited, because "unset" means
# "whatever the next crm-backend image defaults to" and they bound a DoS.
# REALTIME_MAX_CONNECTIONS interacts with nginx: each live stream consumes TWO of
# a worker's `worker_connections` (client leg + upstream leg) and the stock nginx
# image allows 1024 per worker. 500 is a deliberately conservative first number -
# raise it together with `worker_connections`, never alone.
# ============================================
REALTIME_ENABLED=false
REDIS_PASSWORD=changeme_redis_password
REALTIME_TICKET_TTL_SECONDS=30
REALTIME_HEARTBEAT_SECONDS=20
REALTIME_MAX_CONNECTION_SECONDS=900
REALTIME_MAX_CONNECTIONS_PER_USER=4
REALTIME_MAX_CONNECTIONS=500
REALTIME_MINT_PER_MINUTE=30

# ============================================
# BACKEND PROFILE - Address geocoding (crm-backend, map views)
#
# OFF    -> no adapters bound; addresses stay unplotted (the map still works, it
#           just has nothing to draw).
# LOCAL  -> pin drops plus the municipality centroid already stored in
#           `municipality.geo_point`. No network call, ever.
# REMOTE -> LOCAL plus the two free Belgian public geocoders, reached ONLY from
#           the ADMIN-only POST /geocoding/backfill.
#
# LOCAL is the shipped default because REMOTE is outbound traffic to two
# third-party services carrying member address strings. Switch to REMOTE for the
# backfill window, drain the queue, then decide whether to switch back. See
# docs/runbooks/map-views.md.
#
# The two provider URLs are commented out on purpose: crm-backend falls back to
# exactly these values when they are empty, so an override here only makes sense
# for a mirror or an egress proxy - and leaving them unset lets an image update
# move them.
# ============================================
GEOCODING_MODE=LOCAL
# GEOCODING_WALLONIA_URL=https://geoservices.wallonie.be/geocodeWS
# GEOCODING_FLANDERS_URL=https://geo.api.vlaanderen.be/Geolocation
GEOCODING_TIMEOUT_MS=2000
# Hard ceiling on one backfill batch, so a typo cannot start an hours-long run
# against a free public service.
GEOCODING_BATCH_MAX=1000

# ============================================
# BACKEND PROFILE - The BeSt Address register (address picker)
#
# The federal address file (FPS BOSA), self-hosted as the `best-address`
# container in the backend profile. It backs the address picker
# (GET /geocoding/suggest) and the rooftop pin a new meter gets at write time.
#
# BUDGET FOR IT: the image is 1.6 GB and the container settles around 1.7 GB
# RESIDENT. Confirm the VPS has that headroom BEFORE the first
# `--profile backend up -d`, alongside the RAM the unified Postgres instance
# already needs. If it will not fit, blank BEST_ADDRESS_URL below and set
# GEOCODING_MODE=REMOTE: you still get geocoding from the two free public
# services. You lose the picker, not the map.
#
# BLANKING THE VALUE IS THE OFF SWITCH. DELETING THE LINE IS NOT - compose falls
# back to this same default when the variable is unset (the `-` form, not `:-`,
# in docker-compose.yml). Blank it and the suggester is unbound,
# GET /geocoding/suggest answers `[]` rather than erroring, and every address
# form behaves exactly as it did before the feature existed. That silence is
# also how a misconfiguration hides: check `docker compose ps best-address`
# before believing the picker is broken.
#
# The first /addresses read after a cold start takes ~56 s while Postgres pages
# the address table in; the healthcheck issues a real query for that reason and
# the container needs ~2 minutes before it reports healthy. Nothing waits for it.
# ============================================
BEST_ADDRESS_URL=http://best-address:8080/belgianAddress/v2
# Well inside KrakenD's 3000 ms global budget. The box answers an indexed lookup
# in tens of milliseconds once warm; this is the ceiling for a bad day.
BEST_ADDRESS_TIMEOUT_MS=1500

# ============================================
# BACKEND PROFILE - Keycloak Database
# Separate instance (`keycloak-db`), still its own superuser. Keycloak manages
# its own schema at startup, so it is deliberately not consolidated.
# ============================================
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db_password

# ============================================
# BACKEND PROFILE - Email delivery (notification-dispatch)
#
# notification-dispatch is the only thing in the platform that sends email.
# Choose ONE transport:
#
#   EMAIL_TRANSPORT=SMTP   -> fill the SMTP_* block, leave BREVO_API_KEY empty
#   EMAIL_TRANSPORT=BREVO  -> fill BREVO_API_KEY, the SMTP_* block is ignored
#
# There is no third option here: the image also accepts NOOP, but it refuses to
# start with it outside local/test — NOOP marks every message SENT while no mail
# leaves the building.
#
# SMTP_PORT/SMTP_STARTTLS below are the real production defaults (587 + STARTTLS).
# The development stack overrides them to 1025/false for its local Mailpit; do
# not copy those values here.
# ============================================
EMAIL_TRANSPORT=SMTP
EMAIL_FROM_ADDRESS=no-reply@optimce.be
EMAIL_FROM_NAME=OptimCE
EMAIL_REPLY_TO=
# Domain used in the Message-ID header. Should match the sending domain's DNS.
EMAIL_MESSAGE_ID_DOMAIN=optimce.be
# Fallback when outbound_message.locale is empty (fr | nl | de | en).
EMAIL_DEFAULT_LOCALE=fr
SMTP_HOST=changeme_smtp_host
SMTP_PORT=587
SMTP_USERNAME=changeme_smtp_username
SMTP_PASSWORD=changeme_smtp_password
SMTP_STARTTLS=true
SMTP_TLS=false
# Only used when EMAIL_TRANSPORT=BREVO.
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
# Brevo reports bounces by webhook only, and notification-dispatch has no inbound
# HTTP surface by design, so it polls the blocked-contact list instead. 0 disables
# the sync. Only meaningful when EMAIL_TRANSPORT=BREVO.
BREVO_SUPPRESSION_SYNC_INTERVAL_SECONDS=3600
# How often the dispatcher polls outbound_message for due work.
DISPATCH_POLL_INTERVAL_SECONDS=15

# ============================================
# BACKEND PROFILE - Observability (allocation-key-generation, simulation-key)
# Required when ENV=production. Replace these placeholders with real
# ============================================
LOGGING_TOKEN=changeme_logging_token
LOGGING_TRACES_URL=changeme_logging_traces_url
LOGGING_LOGS_URL=changeme_logging_logs_url
LOGGING_METRICS_URL=changeme_logging_metrics_url

# ============================================
# BACKEND PROFILE - Storage (MinIO)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
STORAGE_BUCKET=crm-files
MINIO_PUBLIC_ENDPOINT=http://s3.localhost
# Document-generation buckets: TEMPLATES_BUCKET holds the versioned HTML templates
# seeded by minio-init, OUTPUT_BUCKET receives the rendered invoice/statement PDFs.
TEMPLATES_BUCKET=optimce-templates
OUTPUT_BUCKET=optimce-documents

# ============================================
# BACKEND PROFILE - OpenTelemetry
# ============================================
REMOTE_LOGGING=false
OTEL_EXPORTER_OTLP_ENDPOINT=none

# ============================================
# FRONTEND PROFILE - Nginx upstream hosts
# ============================================
CRM_FRONTEND_UPSTREAM=crm-frontend:80
KRAKEND_UPSTREAM=krakend:8080
KEYCLOAK_UPSTREAM=keycloak:8080
MINIO_UPSTREAM=minio:9000
# Reachable only for `location = ${WEB_REALTIME_PATH}`; everything else still goes
# through krakend.
#
# NOTE: nginx resolves upstream server names at CONFIG LOAD. From now on the
# reverse proxy REFUSES TO START unless crm-backend is running - start the backend
# profile before the frontend profile, which is what docker-stack.sh already does.
CRM_BACKEND_UPSTREAM=crm-backend:80

# Protocols for upstream proxies
CRM_FRONTEND_PROTOCOL=http
KRAKEND_PROTOCOL=http
KEYCLOAK_PROTOCOL=http
MINIO_PROTOCOL=http
CRM_BACKEND_PROTOCOL=http

# ============================================
# FRONTEND PROFILE - SSL/HTTPS
# ============================================
USE_HTTPS=false
SSL_CERT_PATH=/etc/nginx/certs/live/${DOMAIN_HOST}/fullchain.pem
SSL_CERT_KEY_PATH=/etc/nginx/certs/live/${DOMAIN_HOST}/privkey.pem
