{
	"apiUrl": "${DOMAIN}${WEB_API_URL}",
	"basePath": "${WEB_BASE_PATH}",
	"realtimeUrl": "${DOMAIN}${WEB_REALTIME_PATH}",
	"map": {
		"styleUrl": "${WEB_MAP_STYLE_URL}"
	},
	"keycloak": {
		"realm": "${AUTH_REALM}",
		"url": "${DOMAIN}${WEB_AUTH_URL}",
		"clientId": "${WEB_AUTH_CLIENT_ID}",
		"urlPattern": "^(${DOMAIN}${WEB_API_URL})(/.*)?$",
		"urlPatternFlags": "i"
	}
}
